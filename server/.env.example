# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The Vite dev server. Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Security ────────────────────────────────────────────
# Signs session tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage ─────────────────────────────────────────────
# Local development: JSON file database, created on first run.
DATA_FILE=./data/db.json
# Production: set DATABASE_URL to a persistent PostgreSQL connection string.
DATABASE_URL=

# ── AI assistant ────────────────────────────────────────
# Leave AI_API_KEY empty → the built-in MOCK assistant answers (free, offline,
# rule-based). Fill it in → a real LLM is used through any OpenAI-compatible
# Chat Completions API. Pick ONE provider block below.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_TIMEOUT_MS=60000

# OpenRouter (free models end with ":free"; list: https://openrouter.ai/models?max_price=0)
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=<a model id ending in :free>
# Groq (keys: https://console.groq.com/keys; model access depends on your account)
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-20b
# Google Gemini (free tier; keys: https://aistudio.google.com/apikey)
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
# Local Ollama (no key needed, but set any non-empty value)
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=llama3.2
